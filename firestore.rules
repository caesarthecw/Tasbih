rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHex(hex) {
      return hex is string && hex.size() == 7 && hex.matches('^#[0-9A-Fa-f]{6}$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidSoundTone(tone) {
      return tone in ['water_drop', 'wood_bead', 'crystal_chime', 'rain_mist'];
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.coins is int && data.coins >= 0 && data.coins <= 10000000 &&
             data.totalLifetimeTasbih is int && data.totalLifetimeTasbih >= 0 && data.totalLifetimeTasbih <= 100000000 &&
             data.todayTasbih is int && data.todayTasbih >= 0 && data.todayTasbih <= 10000000 &&
             isValidDateKey(data.lastActiveDate) &&
             data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 100000 &&
             isValidId(data.activeDhikrId) &&
             isValidId(data.selectedBeadColorId) &&
             isValidHex(data.customBeadHex) &&
             isValidId(data.selectedThemeId) &&
             isValidId(data.selectedBackgroundId) &&
             isValidId(data.selectedPlantId) &&
             data.soundEnabled is bool &&
             (data.soundVolume is float || data.soundVolume is int) && data.soundVolume >= 0.0 && data.soundVolume <= 1.0 &&
             isValidSoundTone(data.soundTone) &&
             data.hapticEnabled is bool &&
             data.unlockedItems is list && data.unlockedItems.size() <= 100 &&
             (data.unlockedItems.size() == 0 || data.unlockedItems[0] is string) &&
             data.vipUnlocked is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDhikrItem(data, userId) {
      return data.userId == userId &&
             data.phrase is string && data.phrase.size() >= 1 && data.phrase.size() <= 200 &&
             data.subtitle is string && data.subtitle.size() <= 200 &&
             data.dailyGoal is int && data.dailyGoal >= 1 && data.dailyGoal <= 100000 &&
             data.todayCount is int && data.todayCount >= 0 && data.todayCount <= 10000000 &&
             data.totalCount is int && data.totalCount >= 0 && data.totalCount <= 100000000 &&
             isValidDateKey(data.lastUpdatedDate) &&
             isValidHex(data.accentHex) &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
             data.customEntry is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDailyLog(data, userId, dateKey) {
      return data.userId == userId &&
             data.dateKey == dateKey &&
             isValidDateKey(data.dateKey) &&
             data.totalCount is int && data.totalCount >= 0 && data.totalCount <= 10000000 &&
             data.coinsEarned is int && data.coinsEarned >= 0 && data.coinsEarned <= 1000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPurchaseRecord(data, userId) {
      return data.userId == userId &&
             data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 100 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.purchaseType in ['coin_unlock', 'play_billing_coins', 'play_billing_vip', 'reward'] &&
             data.coinDelta is int && data.coinDelta >= -1000000 && data.coinDelta <= 1000000 &&
             data.priceDisplay is string && data.priceDisplay.size() <= 40 &&
             data.orderToken is string && data.orderToken.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'coins', 'totalLifetimeTasbih', 'todayTasbih',
                         'lastActiveDate', 'streakDays', 'activeDhikrId', 'selectedBeadColorId',
                         'customBeadHex', 'selectedThemeId', 'selectedBackgroundId', 'selectedPlantId',
                         'soundEnabled', 'soundVolume', 'soundTone', 'hapticEnabled',
                         'unlockedItems', 'vipUnlocked', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'coins', 'totalLifetimeTasbih', 'todayTasbih',
                         'lastActiveDate', 'streakDays', 'activeDhikrId', 'selectedBeadColorId',
                         'customBeadHex', 'selectedThemeId', 'selectedBackgroundId', 'selectedPlantId',
                         'soundEnabled', 'soundVolume', 'soundTone', 'hapticEnabled',
                         'unlockedItems', 'vipUnlocked', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Tasbih progress & daily streak sync
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'totalLifetimeTasbih', 'todayTasbih', 'lastActiveDate', 'streakDays',
                           'coins', 'activeDhikrId', 'updatedAt'
                         ]) ||
                         // Action 2: Audio, haptic & customization preferences
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'activeDhikrId', 'selectedBeadColorId', 'customBeadHex', 'selectedThemeId',
                           'selectedBackgroundId', 'selectedPlantId', 'soundEnabled', 'soundVolume',
                           'soundTone', 'hapticEnabled', 'displayName', 'updatedAt'
                         ]) ||
                         // Action 3: Store item unlock / Play Billing coin & VIP fulfillment
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'coins', 'unlockedItems', 'vipUnlocked', 'selectedBeadColorId',
                           'selectedThemeId', 'selectedBackgroundId', 'selectedPlantId', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /adhkar/{dhikrId} {
        allow get: if isOwner(userId) && isValidId(dhikrId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(dhikrId) &&
                         incoming().keys().hasAll([
                           'userId', 'phrase', 'subtitle', 'dailyGoal', 'todayCount',
                           'totalCount', 'lastUpdatedDate', 'accentHex', 'sortOrder',
                           'customEntry', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'phrase', 'subtitle', 'dailyGoal', 'todayCount',
                           'totalCount', 'lastUpdatedDate', 'accentHex', 'sortOrder',
                           'customEntry', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidDhikrItem(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(dhikrId) &&
                         isValidDhikrItem(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           // Action 1: Increment or reset daily tasbih count
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'todayCount', 'totalCount', 'lastUpdatedDate', 'updatedAt'
                           ]) ||
                           // Action 2: Edit dhikr phrase, goal, or accent color
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'phrase', 'subtitle', 'dailyGoal', 'accentHex', 'sortOrder', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(dhikrId);
      }

      match /dailyLogs/{dateKey} {
        allow get: if isOwner(userId) && isValidDateKey(dateKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'totalCount', 'coinsEarned', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'totalCount', 'coinsEarned', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidDailyLog(incoming(), userId, dateKey);

        allow update: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         isValidDailyLog(incoming(), userId, dateKey) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'totalCount', 'coinsEarned', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidDateKey(dateKey);
      }

      match /purchases/{purchaseId} {
        allow get: if isOwner(userId) && isValidId(purchaseId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(purchaseId) &&
                         incoming().keys().hasAll([
                           'userId', 'productId', 'title', 'purchaseType',
                           'coinDelta', 'priceDisplay', 'orderToken', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'productId', 'title', 'purchaseType',
                           'coinDelta', 'priceDisplay', 'orderToken', 'createdAt'
                         ]) &&
                         isValidPurchaseRecord(incoming(), userId);

        // Purchase ledger records are immutable audit logs
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(purchaseId);
      }
    }
  }
}
